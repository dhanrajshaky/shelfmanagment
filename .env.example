# Environment Configuration Example for TiDB/PlanetScale MySQL Deployment
# Copy this file to .env in your deployment environment and update the values

# Database Connection Parameters
# From your TiDB/PlanetScale dashboard, use these values:
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DB=shelfmanagment
MYSQL_USER=28ToJeAi16PthQY.root
MYSQL_PASSWORD=<your_password_here>

# Spring Profile
SPRING_PROFILES_ACTIVE=mysql

# Server Configuration
SERVER_PORT=8080
